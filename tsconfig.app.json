{
  "compilerOptions": {
    // -----------------------------------------------------
    // 기본 옵션
    // -----------------------------------------------------
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    // 주석을 포함하지 않고 컴파일
    // "removeComments": true,

    // -----------------------------------------------------
    // 빌드 옵션
    // -----------------------------------------------------
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    // 빌드 출력 폴더를 설정합니다.
    "outDir": "./dist",

    // -----------------------------------------------------
    // 코드 옵션
    // -----------------------------------------------------
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    // "noUncheckedSideEffectImports": true,
    // "noImplicitAny": true, // 명시적인 'any' 타입 사용 금지 (더 안전한 코드 작성)
    // "allowSyntheticDefaultImports": true, // 타입이 지정되지 않은 모듈의 임포트 허용
    // "esModuleInterop": true, // CommonJS/ESM 모듈 간의 상호 운용성을 활성화

    // -----------------------------------------------------
    // 경로 설정 (Path Aliases)
    // -----------------------------------------------------
    
    // 절대 경로의 시작점을 'src' 폴더로 설정합니다. 
    // 이제 'src' 폴더 내부에서 '@shared/...'와 같이 바로 접근할 수 있습니다.
    "baseUrl": "./src",     
    // FSD 레이어별 절대 경로 별칭을 정의합니다.
    "paths": {
      "@src/*": ["src/*"],
      "@app/*": ["app/*"],
      "@pages/*": ["pages/*"],
      "@features/*": ["features/*"],
      "@entities/*": ["entities/*"],
      "@shared/*": ["shared/*"]
    },
  },

  // -----------------------------------------------------
  // 포함 불포함 사항
  // -----------------------------------------------------
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
